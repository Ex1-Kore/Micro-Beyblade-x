# ─── Database ────────────────────────────────────────────────────────────────
# ถ้าไม่ตั้ง DATABASE_URL ระบบจะ fallback ไปที่ prisma/dev.db ในโปรเจกต์อัตโนมัติ
# ตัวอย่าง absolute path (ใช้ได้ทั้ง local และ production):
# DATABASE_URL="file:/absolute/path/to/prisma/dev.db"
#
# Postgres / Supabase (ยังไม่เปิดใช้งาน — ดู skill supabase-migration):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# ─── Admin (cookie auth) ─────────────────────────────────────────────────────
# รหัสผ่านเข้าหน้า /admin — ถ้าไม่ตั้ง ระบบ admin จะถูกปิดทั้งหมด
ADMIN_PASSWORD="change-me"

# secret สำหรับเซ็น cookie session (ถ้าไม่ตั้งจะใช้ ADMIN_PASSWORD แทน)
ADMIN_SECRET="change-me-too"
